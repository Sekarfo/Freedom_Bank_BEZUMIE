# --- Источник данных -------------------------------------------------------
# Ссылка GET организаторов БЕЗ параметра group_id (он добавляется кодом).
ORGANIZERS_API_URL=https://...powerplatform.com/powerautomate/automations/direct/.../invoke?api-version=1&sp=...&sv=1.0&sig=...

# --- Локальная модель (этап 1) ---------------------------------------------
# ollama  — нативный API Ollama (/api/chat, параметры format и think)
# openai  — любой OpenAI-совместимый сервер (vLLM, SGLang): base_url вида http://host:8001/v1
LOCAL_LLM_BACKEND=ollama
# Нативный запуск backend: http://localhost:11434 ; backend в Docker: http://host.docker.internal:11434
LOCAL_LLM_BASE_URL=http://localhost:11434
# qwen3-8b | qwen3.5-9b | или точный тег Ollama (например qwen3:8b-q8_0)
LOCAL_MODEL=qwen3-8b
# Переопределение тегов: "qwen3-8b=qwen3:8b,qwen3.5-9b=qwen3.5:9b"
LOCAL_MODEL_TAGS=
# Режим рассуждения Qwen (true — качество выше, но медленнее)
LOCAL_THINK=false
LOCAL_NUM_CTX=16384
LOCAL_CONCURRENCY=1
# Qwen через OpenRouter вместо Ollama (qwen/qwen3-8b там без провайдеров — берём qwen3.5-9b):
#   LOCAL_LLM_BACKEND=openai
#   LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
#   LOCAL_MODEL=qwen3.5-9b
#   LOCAL_MODEL_TAGS=qwen3.5-9b=qwen/qwen3.5-9b
#   LOCAL_CONCURRENCY=8
# ~$0.0009 и ~15 с на диалог; в results.json попадёт mode=external_api.
OPENROUTER_API_KEY=

# --- Облако (этап 2) --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждения Claude: low | medium | high
ANTHROPIC_EFFORT=medium
# Серверный fallback при отказе модели (beta server-side-fallback-2026-07-01)
ANTHROPIC_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=
# Цены OpenAI, $ за 1 млн токенов — заполнить с официальной страницы цен
OPENAI_PRICE_IN=0
OPENAI_PRICE_OUT=0
# Пусто — не передавать temperature (некоторые reasoning-модели её не принимают)
OPENAI_TEMPERATURE=0

# --- Режимы по умолчанию ----------------------------------------------------
DEFAULT_MODE=cloud
DEFAULT_PROVIDER=anthropic
HYBRID_STRATEGY=review
CLOUD_CONCURRENCY=4

TEAM_NAME=Freedom_Bank_BEZUMIE
