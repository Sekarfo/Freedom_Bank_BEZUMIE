# --- Источник данных -------------------------------------------------------
# Ссылка GET организаторов БЕЗ параметра group_id (он добавляется кодом).
ORGANIZERS_API_URL=https://...powerplatform.com/powerautomate/automations/direct/.../invoke?api-version=1&sp=...&sv=1.0&sig=...

# --- Модель-судья: Claude (по умолчанию) -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждения Claude: low | medium | high
ANTHROPIC_EFFORT=medium
# Серверный fallback при отказе модели (beta server-side-fallback-2026-07-01)
ANTHROPIC_FALLBACKS=true

# --- Запасной путь: любой OpenAI-совместимый API ---------------------------
# Например, Claude через OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# OPENAI_MODEL=anthropic/claude-opus-5.5, OPENAI_TEMPERATURE= (пусто). Включается DEFAULT_PROVIDER=openai
# или переключателем в разделе «Настройки модели».
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Цены, $ за 1 млн токенов — заполнить с официальной страницы цен
OPENAI_PRICE_IN=0
OPENAI_PRICE_OUT=0
# Пусто — не передавать temperature (некоторые модели её не принимают)
OPENAI_TEMPERATURE=0

# --- Персональные данные ----------------------------------------------------
# Маскировать перед отправкой транскрипта в модель: имена, ИИН/БИН, карты, IBAN, телефоны, e-mail,
# даты рождения, номера документов и счетов, адреса, коды из SMS/PIN/CVV/пароли, номера словами.
# В БД и в интерфейсе остаётся исходный текст.
PII_MASKING=true
# NER для имён: slovnet (Natasha, CPU, без сети) | off (только правила).
# Если NER не загрузился, оценка завершается ошибкой — немаскированные данные наружу не уходят.
PII_NER=slovnet

# --- Прочее -----------------------------------------------------------------
# anthropic | openai
DEFAULT_PROVIDER=anthropic
# Сколько диалогов оценивается параллельно
CLOUD_CONCURRENCY=4

TEAM_NAME=Freedom_Bank_BEZUMIE
